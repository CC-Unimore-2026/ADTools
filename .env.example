# Centralized input for gen_env.py.
#
# Copy this file to ".env" and fill in the values. gen_env.py reads ".env" and
# uses each value as the DEFAULT for its prompt: press Enter to accept the
# default, or type a new value to override it. Leaving a field blank here just
# means gen_env.py prompts for it with no default.
#
# ".env" is gitignored — never commit real tokens. Generated secrets
# (root_password, packmate_password, ctffarm_password, flag_dashboard_*) are
# NOT listed here: gen_env.py generates them randomly into .env.json.

# Vulnbox target IPv4
VULNBOX_IP=

# Gameserver URL for flag submission (must start with http://)
GAMESERVER_URL=http://10.10.0.1:8080/flags

# Team token (flag submission auth, from the competition portal)
TEAM_TOKEN=

# Number of teams in the game
NUMBER_OF_TEAMS=

# Python format string for team IPs — MUST contain {i}
TEAM_IP_FORMAT=10.60.{i}.1

# Game network interface on the vulnbox (check with `ip link`)
GAME_INTERFACE=game

# GitHub org to PUSH the vulnbox service folders to (private repos)
GITHUB_ORG=
# GitHub token with push access to GITHUB_ORG
GITHUB_TOKEN=

# GitHub org hosting the TOOL repos (KickStarterPy, threesome, dashboard, wisscon)
TOOL_REPOS_ORG=
# GitHub token with read access to TOOL_REPOS_ORG
TOOL_REPOS_TOKEN=

# Exploit VM (WireGuard) — leave empty until the VPS is ready
EXPLOIT_VM_ENDPOINT=
EXPLOIT_VM_PUBKEY=
VULNBOX_PRIVKEY=
